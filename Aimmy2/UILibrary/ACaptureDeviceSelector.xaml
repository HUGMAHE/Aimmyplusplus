<UserControl
    x:Class="Aimmy2.UILibrary.ACaptureDeviceSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#1E1E2E" Margin="10">
        <StackPanel Orientation="Vertical">
            <!-- Title -->
            <TextBlock 
                Text="Sélectionner Source Vidéo" 
                Foreground="#FFFFFF" 
                FontSize="14"
                FontWeight="SemiBold"
                Margin="0,0,0,10"/>

            <!-- Device Dropdown -->
            <ComboBox 
                Name="DeviceComboBox"
                Background="#2D2D44"
                Foreground="#FFFFFF"
                BorderBrush="#44475A"
                BorderThickness="1"
                Padding="8,6"
                FontSize="12"
                Margin="0,0,0,10"
                SelectionChanged="DeviceComboBox_SelectionChanged"/>

            <!-- Refresh Button -->
            <Button 
                Name="RefreshButton"
                Content="Actualiser Liste"
                Background="#44475A"
                Foreground="#FFFFFF"
                Padding="8,6"
                Margin="0,0,0,10"
                Click="RefreshButton_Click"
                Cursor="Hand"/>

            <!-- Status Text -->
            <TextBlock 
                Name="StatusText"
                Foreground="#8BE9FD"
                FontSize="11"
                TextWrapping="Wrap"
                Margin="0,5,0,10"/>

            <!-- Open Button -->
            <Button 
                Name="OpenButton"
                Content="Ouvrir Source"
                Background="#50FA7B"
                Foreground="#000000"
                Padding="8,6"
                FontWeight="SemiBold"
                Click="OpenButton_Click"
                IsEnabled="False"
                Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
